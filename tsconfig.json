{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "packages/plugin/src",
    "types": ["bun-types"]
  },
  "include": ["packages/plugin/src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
